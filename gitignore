# Keep this file at the repository root.
# IMPORTANT: dependency manifests/lockfiles (go.mod, go.sum,
# package.json, package-lock.json, yarn.lock, pnpm-lock.yaml)
# are intentionally NOT ignored; they should normally be committed.
